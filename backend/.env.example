APP_NAME=Job Dheako API
API_PREFIX=/api/v1
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_URL=postgresql+psycopg://jobdheako:jobdheako@localhost:5433/job_dheko
DEBUG=true
SECRET_KEY=dev-only-change-this-before-production
ALGORITHM=HS256
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=jobdheako-career
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_UPLOAD_MB=5
TTS_VOICE=default
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@jobdheako.com
SMTP_USE_TLS=true
FRONTEND_URL=http://localhost:5173
OTP_EXPIRE_MINUTES=10
MAX_OTP_ATTEMPTS=5
EXPOSE_DEV_CODES=true
